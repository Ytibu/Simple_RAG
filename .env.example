# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1# 百炼已推出业务空间专属域名（{workspaceId}.{region}.maas.aliyuncs.com），原有 DashScope 共享域名（dashscope.aliyuncs.com）将于 2026年9月30日起进入维护状态。
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=qwen3-vl-plus
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
#BGE_DEVICE=cuda:0
BGE_DEVICE=cpu
# 是否使用半精度（True/False）
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://127.0.0.1:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://127.0.0.1:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=127.0.0.1:9000
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base
# 可选的原文件归档桶，需预先创建并关闭匿名读取
MINIO_IMPORT_ARCHIVE_BUCKET=

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
# BGE-M3 本地嵌入维度，独立于云端 EMBEDDING_DIM
BGE_EMBEDDING_DIM=1024

# 是否调用大语言模型描述图片和识别主体；false 时图片仅上传，主体采用文件名
IMPORT_USE_LLM=true

# ====================
# MinerU 云 API（所有 PDF 统一使用）
# ====================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_MODEL_VERSION=vlm
# 单次 HTTP 超时、任务总超时、轮询间隔，单位秒
MINERU_REQUEST_TIMEOUT=60
MINERU_TASK_TIMEOUT=600
MINERU_POLL_INTERVAL=3

# 查询重排：auto 优先使用已有本地模型，缺失时使用 LLM；local 强制本地，llm 强制云端
QUERY_RERANKER=auto
